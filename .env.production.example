# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env on your server and fill in real values
# ===========================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_random_password
POSTGRES_DB=myapp_production

# --- Rails ---
SECRET_KEY_BASE=CHANGE_ME_run_openssl_rand_hex_128
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_64

# --- Domain (your actual domain — used in CORS, email links, ActiveStorage URLs) ---
DOMAIN=yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com
BACKEND_HOST=https://yourdomain.com

# --- Admin (change after first login, then remove) ---
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_DOMAIN=yourdomain.com
COMPANY_EMAIL=info@yourdomain.com
COMPANY_NAME=Your Business Name

# --- Google Calendar (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/admin/google-callback
